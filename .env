# Required for admin login. Use a strong unique password.
ADMIN_USERNAME=change_me_admin
ADMIN_PASSWORD=change_me_to_a_long_random_password

# Keep the existing key if institution passwords have already been encrypted.
# Generate a new key only if you understand the effect on stored encrypted passwords:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INSTITUTION_PASSWORD_ENCRYPTION_KEY=replace_with_your_fernet_key

# Local defaults use folders inside backend/. For a persistent host disk you can use:
# DATA_DIR=/var/data/data
# SESSIONS_DIR=/var/data/sessions
# UPLOAD_DIR=/var/data/uploads